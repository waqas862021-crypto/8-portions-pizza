# AI API configuration for CafeBot's backend (Phase B — not built yet).
# Copy this file to .env and fill in real values there. .env is gitignored
# and must never be committed; this file holds placeholder names only.

# API key for whichever AI provider CafeBot ends up using.
AI_API_KEY=

# Base URL of that provider's API (only needed if it's not the default).
AI_API_BASE_URL=

# Which model to call.
AI_MODEL_NAME=
