# Copy this file to ".env" and fill in real values.
# Never commit your real .env file to version control.

# API key for whichever AI provider you choose (OpenAI, Anthropic, etc.)
AI_API_KEY=your_api_key_here

# Which model to use — pick a small/cheap one to start and keep costs low
AI_MODEL=gpt-4o-mini

# Port the backend server runs on (used once the backend exists)
PORT=8000

# Optional: environment name (development / production)
ENVIRONMENT=development
