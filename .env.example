# Configuration for backend/server.ps1 (CafeBot's backend).
# Copy this file to .env and fill in real values there. .env is gitignored
# and must never be committed; this file holds placeholder names only.
# Without a valid .env, backend/server.ps1 starts and serves the staff
# dashboard/orders API fine, but POST /api/chat fails until all three
# AI_* values below are set (see Invoke-AiChatCompletion).

# API key for whichever OpenAI-compatible AI provider CafeBot uses.
AI_API_KEY=

# Base URL of that provider's API, e.g. https://api.openai.com/v1 -
# required, there is no built-in default. "/chat/completions" is
# appended automatically.
AI_API_BASE_URL=

# Which model to call.
AI_MODEL_NAME=

# Deterministic pricing config for CafeBot's order totals (not secrets,
# but kept alongside the rest of the backend's config). Both are plain
# numbers; leave blank to default to 0.

# Tax rate as a percentage applied to the discounted items subtotal,
# e.g. 15 means 15%.
TAX_RATE=

# Flat delivery fee (in the menu's currency) charged only on delivery
# orders.
DELIVERY_FEE=
